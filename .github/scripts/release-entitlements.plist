<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime blocks outgoing Apple Events without this; the app
         talks to Finder to save images to folders (see NSAppleEventsUsageDescription). -->
    <!-- Entitlement audit (2026-08, distribution workstream): retained on real
         code evidence — ClipboardManager.getFinderSelectedFolder() executes
         `tell application "Finder"` via NSAppleScript
         (Sources/Engine/ClipboardManager.swift). No other entitlement is
         authorized: get-task-allow, library-validation disables, JIT,
         unsigned-executable-memory and DYLD exceptions must never appear here;
         scripts/package.sh fails a build that embeds get-task-allow=true. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
